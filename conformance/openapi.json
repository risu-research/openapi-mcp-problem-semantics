    "/S00-asymmetry": {
      "get": {
        "operationId": "fixture_S00_asymmetry",
        "summary": "Same-tool success/error representation asymmetry control",
        "parameters": [
          {
            "name": "outcome",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "success",
                "problem"
              ]
            },
            "description": "Select a 200 JSON success or 403 RFC 9457 Problem Details response."
          }
        ],
        "responses": {
          "200": {
            "description": "Structured success control",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "probe": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "ok",
                    "probe"
                  ]
                }
              }
            }
          },
          "403": {
            "description": "RFC 9457 problem control",
            "content": {
              "application/problem+json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "format": "uri"
                    },
                    "title": {
                      "type": "string"
                    },
                    "status": {
                      "type": "integer"
                    },
                    "detail": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "type",
                    "title",
                    "status",
                    "code"
                  ]
                }
              }
            }
          }
        }
      }
    }
